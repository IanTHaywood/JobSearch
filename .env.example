MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=changeme

MONGO_DB_NAME=jobsearch
MONGO_URI=mongodb://admin:changeme@localhost:27017/?authSource=admin

RAPIDAPI_KEY=your_rapidapi_key
JOBS_API14_QUERY=software engineer
JOBS_API14_LOCATION=
JOBS_API14_COUNTRY_CODE=us
# RapidAPI calls are metered; set this to your plan's actual daily limit
# (check the RapidAPI dashboard) so the connector stops itself before
# overrunning it instead of erroring out mid-run. Unset = no cap enforced.
JOBS_API14_INDEED_DAILY_CALL_CAP=20

# A listing not re-seen by its connector in this many days is flagged
# stale (see /api/listings' `stale` field) rather than removed.
STALE_AFTER_DAYS=5
